{
  "name": "slaude",
  "version": "0.46.0-rc.17",
  "type": "module",
  "private": true,
  "description": "Slack-native Claude Code runtime. Onboard AI agent as team member.",
  "author": "Zidni Mubarok <zidmubarock@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barockok/slaude.git"
  },
  "bugs": {
    "url": "https://github.com/barockok/slaude/issues"
  },
  "homepage": "https://github.com/barockok/slaude#readme",
  "main": "src/server.ts",
  "bin": {
    "slaude": "bin/slaude.ts"
  },
  "scripts": {
    "link": "chmod +x bin/slaude.ts && ln -sf \"$PWD/bin/slaude.ts\" \"$HOME/.bun/bin/slaude\" && echo linked: $HOME/.bun/bin/slaude",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "worker": "bun src/node/main.ts",
    "sim": "bun src/gateway/sim/cli.ts",
    "brain-export": "bun src/cli/brain-export.ts",
    "brain-import": "bun src/cli/brain-import.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "docs": "bun docs/site/build.mjs",
    "schema:agent": "bun scripts/gen-agent-schema.ts",
    "panel:dev": "vite --config src/web/vite.console.config.ts",
    "panel:build": "vite build --config src/web/vite.console.config.ts",
    "portal:dev": "vite --config src/web/vite.portal.config.ts",
    "portal:build": "vite build --config src/web/vite.portal.config.ts",
    "web:build": "bun run panel:build && bun run portal:build",
    "panel:shots": "node tests/panel-web/shoot.mjs",
    "test:web": "playwright test -c tests/panel-web/playwright.config.ts",
    "manifest": "bun src/cli/manifest.ts",
    "slack-app": "bun src/cli/slack-app.ts",
    "node-token": "bun src/cli/node-token.ts",
    "personas": "bun src/cli/personas.ts",
    "validate-soul": "bun src/cli/validate.ts",
    "install-deps": "bun src/cli/install.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "brain-backfill": "bun src/cli/brain-backfill.ts",
    "brain-reembed": "bun src/cli/brain-reembed.ts",
    "migrate-sqlite": "bun src/cli/migrate-sqlite.ts",
    "test:pg": "SLAUDE_DB=pg bun test"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.43.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.0",
    "ajv": "8.20.0",
    "marked": "^18.0.11",
    "react-dom": "19.2.7",
    "typescript": "^5",
    "vite": "^8.2.2",
    "zod-to-json-schema": "3.25.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.173",
    "@anthropic-ai/sdk": "^0.104.1",
    "@electric-sql/pglite": "^0.5.7",
    "@opentui/core": "^0.3.2",
    "@opentui/react": "^0.3.2",
    "@slack/bolt": "^4.1.0",
    "bullmq": "^6.2.0",
    "gbrain": "github:garrytan/gbrain#03ffc6ebdbc7dd8b29e5bfd0c3a9a6c983b54f01",
    "ioredis": "^6.0.0",
    "re2js": "^2.9.1",
    "react": "^19.2.7",
    "ssh2": "^1.17.0",
    "yaml": "^2.6.0",
    "zod": "^3.25.28"
  }
}
