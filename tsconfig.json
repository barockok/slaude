{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  // The browser apps (src/web: console and portal, React + DOM) are checked by
  // their own src/web/tsconfig.json, intentionally separate from the Bun-native
  // server (design §Frontend), so DOM globals there do not leak into the backend
  // check. `bun run typecheck` runs both.
  // deploy/k8s-local/probe runs INSIDE a container and imports the image's own
  // /app/src paths, which do not resolve on a developer machine. It is verified
  // by running it, not by this typecheck. e2e/harness/in-pod is the same kind of file.
  "exclude": ["src/web", "tests/panel-web", "deploy/k8s-local/probe", "e2e/harness/in-pod"]
}
