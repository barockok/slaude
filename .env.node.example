# slaude node (worker) environment for docker-compose.yaml's `scale` profile.
# Copy to .env.node and fill in. NODE VARIABLES ONLY: a node refuses to boot
# (SLAUDE_NODE_BOOT_CHECK=refuse, the default) when its environment holds a
# gateway-only variable such as a Slack token, the job secret, the master key
# or a database URL. Those stay in the gateway's .env.

# --- Node credential ---
# The node's /v1 credential: a signed node credential (`bun run node-token mint`
# on a gateway), or the gateway's legacy shared token (the gateway reads it as
# SLAUDE_NODE_LEGACY_TOKEN).
SLAUDE_NODE_TOKEN=

# --- Gateway and queue (compose sets these defaults; override here if needed) ---
# SLAUDE_GATEWAY_URL=http://slaude:8080
# SLAUDE_REDIS_URL=redis://redis:6379
# SLAUDE_NODE_PORT=8081

# --- LLM provider (node-env fallback) ---
# Used by personas that do not carry their own provider credentials
# (SLAUDE_PROVIDER_ENV_FALLBACK=1, the default). Pick ONE auth mode.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# SLAUDE_MODEL=claude-sonnet-4-6
